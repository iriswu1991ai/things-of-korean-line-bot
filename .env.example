# Server
PORT=3000
BASE_URL=https://your-public-domain.example
TIMEZONE=Asia/Taipei

# Finance LINE Official Account
LINE_FINANCE_CHANNEL_ACCESS_TOKEN=
LINE_FINANCE_CHANNEL_SECRET=
# Optional comma-separated user IDs. If omitted, users are collected from follow/message webhook events.
LINE_FINANCE_TARGET_IDS=
# Optional comma-separated RSS feeds for market/news headlines.
FINANCE_NEWS_RSS_URLS=https://feeds.bbci.co.uk/news/business/rss.xml,https://www.cnbc.com/id/100003114/device/rss/rss.html

# Korean TOPIK LINE Official Account
LINE_KOREAN_CHANNEL_ACCESS_TOKEN=
LINE_KOREAN_CHANNEL_SECRET=
LINE_KOREAN_TARGET_IDS=

# HANHAN LINE Official Account
LINE_HANHAN_CHANNEL_ACCESS_TOKEN=
LINE_HANHAN_CHANNEL_SECRET=
# Optional comma-separated user/group IDs. If omitted, PUSH_HANHAN_LINE=1 will broadcast to all friends.
LINE_HANHAN_TARGET_IDS=
# Public HTTPS base URL for generated image folders, e.g. https://raw.githubusercontent.com/user/repo/main/out/ig
HANHAN_IMAGE_BASE_URL=
